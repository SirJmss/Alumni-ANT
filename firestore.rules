rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isStaffOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jamessvenansali@gmail.com' ||
        (request.auth.token.role in ['admin', 'staff', 'registrar', 'moderator']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff', 'registrar', 'moderator'])
      );
    }
    
    function isAlumni() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'alumni'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isStaffOrAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isStaffOrAdmin());
      
      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
      match /following/{followingUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
      match /connections/{connectedUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Friend Requests (Alumni-to-alumni connections)
    match /friend_requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Chats and nested messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Notifications (User can only read/update/delete their own)
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.toUid == request.auth.uid
      );
      allow create: if isSignedIn();
    }

    // Events (Readable by all auth users; create/update/delete by staff/admin/registrar/moderator)
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaffOrAdmin();
      
      match /likes/{userId} {
        allow read, write: if isSignedIn();
      }
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow delete: if isStaffOrAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Announcements (Staff & Admin only for write)
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaffOrAdmin();
    }

    // Opportunities & Jobs
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Official Registrar Registry Records (Uploaded CSV/Excel masterlist)
    match /registry_records/{recordId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaffOrAdmin();
      // Allow registration linking by matched user or staff/admin
      allow update: if isSignedIn();
    }

    // Fallback catch-all for other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
